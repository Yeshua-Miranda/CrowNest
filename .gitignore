# ==========================================
node_modules/
npm-debug.log
yarn-error.log
package-lock.json # Opcional: Descomenta si prefieres no subir las versiones exactas, aunque suele recomendarse dejarlo.

# ==========================================
# Variables de entorno y secretos
# ==========================================
.env
.env.test
.env.production
.env.local

# AQUÍ: Pon la ruta exacta del archivo JS que vimos en el mensaje anterior
# Por ejemplo, si está en FRONTEND/js/env.js, descomenta y usa la línea de abajo:
# FRONTEND/js/env.js
# FRONTEND/js/config.js
FRONTEND/controllers/env.js

# ==========================================
# Archivos de Logs
